{
  "name": "tereco-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "TERECO Collect desktop",
  "author": "TERECO",
  "homepage": "https://github.com/dementa/tereco",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "npm run prepack:check && electron-builder --publish never",
    "dist:win": "npm run prepack:check && electron-builder --win --publish never",
    "dist:win:publish": "npm run prepack:check && electron-builder --win --publish always",
    "dist:linux": "npm run prepack:check && electron-builder --linux --publish never",
    "dist:mac": "npm run prepack:check && electron-builder --mac --publish never",
    "prepack:check": "npm run renderer:check && npm run native:check",
    "renderer:check": "node -e \"require('fs').existsSync('renderer/dist/index.html')||(console.error('renderer/dist is missing. Run npm run build:renderer from the REPO ROOT first: without it the installer ships no application code.'),process.exit(1))\"",
    "native:check": "node scripts/check-native-build.js",
    "smoke": "node scripts/smoke-installed-app.js",
    "rebuild": "electron-rebuild -f -w better-sqlite3-multiple-ciphers",
    "postinstall": "electron-rebuild -f -w better-sqlite3-multiple-ciphers"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.tereco.collect",
    "productName": "TERECO Collect",
    "copyright": "Copyright © TERECO",
    "publish": {
      "provider": "github",
      "owner": "dementa",
      "repo": "tereco",
      "releaseType": "release"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "package.json",
      "renderer/dist/**",
      "db/**",
      "net/**",
      "keys/**"
    ],
    "extraResources": [
      {
        "from": "../lib/offline",
        "to": "lib/offline",
        "filter": [
          "*.js"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TERECO Collect"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Education",
      "icon": "build/icon.png",
      "maintainer": "TERECO <support@tereco.local>"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.education",
      "icon": "build/icon.png"
    }
  },
  "dependencies": {
    "better-sqlite3-multiple-ciphers": "12.11.1",
    "electron-updater": "6.8.9"
  }
}
